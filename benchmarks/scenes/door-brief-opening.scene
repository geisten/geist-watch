# geist-watch scene manifest — NEGATIVE scene.
# No `truth` lines: the correct outcome is that nothing is emitted. If
# the core ever fires here, the harness reports a false positive and the
# precision floor fails the run.
version 1
scene door-brief-opening
split test
camera cam-hall
match_window 30000
tick_ms 1000

rule front-door sustained yes 2 2000 15000 300000

# Open for sixty seconds, then closed. A fifth of the required duration,
# so no event. The obvious failure this guards against is a rule that
# fires on the transition rather than on the duration.

sample 0 - front-door=yes
sample 2000 - front-door=yes
sample 10000 - front-door=yes
sample 20000 - front-door=yes
sample 30000 - front-door=yes
sample 40000 - front-door=yes
sample 50000 - front-door=yes
sample 60000 - front-door=yes
sample 70000 - front-door=no
sample 80000 - front-door=no
sample 90000 - front-door=no
sample 100000 - front-door=no
sample 110000 - front-door=no
sample 120000 - front-door=no
sample 130000 - front-door=no
sample 140000 - front-door=no
sample 150000 - front-door=no
sample 160000 - front-door=no
sample 170000 - front-door=no
sample 180000 - front-door=no
sample 190000 - front-door=no
sample 200000 - front-door=no
