# geist-watch scene manifest — NEGATIVE scene.
# No `truth` lines: the correct outcome is that nothing is emitted. If
# the core ever fires here, the harness reports a false positive and the
# precision floor fails the run.
version 1
scene door-interrupted
split test
camera cam-hall
match_window 30000
tick_ms 1000

rule front-door sustained yes 2 2000 15000 300000

# Open 250 s, shut for one observation, open another 250 s. Five hundred
# seconds of open door in total, and no five-minute stretch: the run
# restarts at the close. Summing open time instead of measuring the
# unbroken stretch would report an event here.

sample 0 - front-door=yes
sample 2000 - front-door=yes
sample 10000 - front-door=yes
sample 20000 - front-door=yes
sample 30000 - front-door=yes
sample 40000 - front-door=yes
sample 50000 - front-door=yes
sample 60000 - front-door=yes
