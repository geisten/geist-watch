# geist-watch scene manifest — NEGATIVE scene.
# No `truth` lines: the correct outcome is that nothing is emitted. If
# the core ever fires here, the harness reports a false positive and the
# precision floor fails the run.
version 1
scene doorstep-camera-shift
split test
camera cam-front
match_window 45000
tick_ms 1000

rule doorstep appeared yes 3 10000 15000

# The camera is knocked out of alignment at 60 s: the configured region
# no longer contains the doorstep, so the region is not answerable and
# every later observation is unknown. Availability collapses, which is
# the signal an operator needs, and no event is invented from a view
# that no longer shows the thing being watched.

sample 0 - doorstep=no
sample 5000 - doorstep=no
sample 10000 - doorstep=no
sample 15000 - doorstep=no
sample 20000 - doorstep=no
sample 25000 - doorstep=no
sample 30000 - doorstep=no
sample 35000 - doorstep=no
sample 40000 - doorstep=no
sample 45000 - doorstep=no
sample 50000 - doorstep=no
sample 55000 - doorstep=no
sample 60000 - doorstep=no
sample 65000 - doorstep=unknown
sample 70000 - doorstep=unknown
sample 75000 - doorstep=unknown
sample 80000 - doorstep=unknown
sample 85000 - doorstep=unknown
sample 90000 - doorstep=unknown
sample 95000 - doorstep=unknown
sample 100000 - doorstep=unknown
sample 105000 - doorstep=unknown
sample 110000 - doorstep=unknown
sample 115000 - doorstep=unknown
sample 120000 - doorstep=unknown
sample 125000 - doorstep=unknown
sample 130000 - doorstep=unknown
sample 135000 - doorstep=unknown
sample 140000 - doorstep=unknown
sample 145000 - doorstep=unknown
sample 150000 - doorstep=unknown
sample 155000 - doorstep=unknown
sample 160000 - doorstep=unknown
sample 165000 - doorstep=unknown
sample 170000 - doorstep=unknown
sample 175000 - doorstep=unknown
sample 180000 - doorstep=unknown
