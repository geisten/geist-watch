# geist-watch scene manifest — NEGATIVE scene.
# No `truth` lines: the correct outcome is that nothing is emitted. If
# the core ever fires here, the harness reports a false positive and the
# precision floor fails the run.
version 1
scene doorstep-flicker
split test
camera cam-front
match_window 45000
tick_ms 1000

rule doorstep appeared yes 3 10000 15000

# Backlight and dusk do not make the model say "parcel"; they make it
# stop agreeing with itself. The label stream alternates and never
# reaches three consecutive agreeing observations, so the state stays
# unknown and no event is produced.
#
# What the model ACTUALLY answers under hard light is an open question
# that only footage settles. What is pinned here is narrower and still
# worth pinning: given an unstable answer, the core emits nothing.

sample 0 - doorstep=no
sample 5000 - doorstep=yes
sample 10000 - doorstep=unknown
sample 15000 - doorstep=yes
sample 20000 - doorstep=no
sample 25000 - doorstep=yes
sample 30000 - doorstep=unknown
sample 35000 - doorstep=no
sample 40000 - doorstep=yes
sample 45000 - doorstep=unknown
sample 50000 - doorstep=no
sample 55000 - doorstep=yes
sample 60000 - doorstep=unknown
sample 65000 - doorstep=yes
sample 70000 - doorstep=no
sample 75000 - doorstep=yes
sample 80000 - doorstep=unknown
sample 85000 - doorstep=no
sample 90000 - doorstep=yes
sample 95000 - doorstep=unknown
sample 100000 - doorstep=no
sample 105000 - doorstep=yes
sample 110000 - doorstep=unknown
sample 115000 - doorstep=yes
