# geist-watch scene manifest — NEGATIVE scene.
# No `truth` lines: the correct outcome is that nothing is emitted. If
# the core ever fires here, the harness reports a false positive and the
# precision floor fails the run.
version 1
scene doorstep-passerby
split test
camera cam-front
match_window 45000
tick_ms 1000

rule doorstep appeared yes 3 10000 15000

# Someone carries a parcel through the doorway region. It is genuinely
# visible, and the model genuinely answers yes — for two frames. Neither
# the count nor the ten-second window is satisfied, so nothing confirms.
# This is the case the confirmation window exists for.

sample 0 - doorstep=no
sample 5000 - doorstep=no
sample 10000 - doorstep=no
sample 15000 - doorstep=no
sample 20000 - doorstep=no
sample 25000 - doorstep=no
sample 30000 - doorstep=no
sample 35000 - doorstep=yes
sample 40000 - doorstep=yes
sample 45000 - doorstep=no
sample 50000 - doorstep=no
sample 55000 - doorstep=no
sample 60000 - doorstep=no
sample 65000 - doorstep=no
sample 70000 - doorstep=no
sample 75000 - doorstep=no
sample 80000 - doorstep=no
sample 85000 - doorstep=no
sample 90000 - doorstep=no
